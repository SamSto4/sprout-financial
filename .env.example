# Copy this file to .env and fill in the values. .env is ignored by git; never commit it.
# On Vercel, add the same names under Project Settings > Environment Variables instead.

# --- Required for the assistant and the AI spending review ---
# Anthropic API key (ANTHROPIC_API_KEY also works).
CLAUDE_API_KEY=

# --- Optional ---
# Model the assistant uses. Defaults to claude-opus-5-5.
# ANTHROPIC_MODEL=

# Financial Modeling Prep key. Enables the stock quote and company lookup tools.
# FMP_API_KEY=

# MongoDB connection string. Enables accounts, sync and shared rate-limit counters.
# Without it the app runs browser-only and hides login.
# MONGODB_URI=
# MONGODB_DB=financial-literacy

# Signs session cookies; needed when MONGODB_URI is set. Generate with: openssl rand -base64 32
# AUTH_SECRET=

# Google sign-in (AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET also work). Redirect URI to register in the
# Google Cloud console: <site URL>/api/auth/callback/google (http://localhost:3000 locally).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Set to "off" to disable web search and deep research (billed per search).
# WEB_SEARCH=

# Rate limits on the AI endpoints and login. On by default in production, off in development.
# RATE_LIMIT=on
# Most AI calls allowed per day across all visitors. Defaults to 400.
# RATE_LIMIT_DAILY_TOTAL=

# Model that grades replies in `npm run eval`. Defaults to the assistant's model.
# EVAL_GRADER_MODEL=
