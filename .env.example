# Copy this file to .env and fill in the values. .env is ignored by git; never commit it.
# On Vercel, add the same names under Project Settings > Environment Variables instead.

# --- Required for the assistant and the AI spending review ---
# Anthropic API key (ANTHROPIC_API_KEY also works).
CLAUDE_API_KEY=

# --- Optional ---
# Model the assistant uses. Defaults to claude-haiku-5-5 (fastest and cheapest).
# ANTHROPIC_MODEL=

# Model that reads screenshots on the Dashboard and Portfolio pages. Defaults to ANTHROPIC_MODEL.
# Compare models with npm run eval:screenshots before changing it.
# SCREENSHOT_MODEL=

# Monthly budget in US dollars for all AI calls together (chat, the spending review and screenshot import). Each call's
# cost is estimated from list prices; once the month's total reaches this, the assistant pauses until
# the next month. Unset means no budget check. Keep a spend limit in the Claude Console as well.
# SPENDING_LIMIT=100

# Financial Modeling Prep key. Enables the stock quote and company lookup tools.
# FMP_API_KEY=

# MongoDB connection string. Enables accounts, sync and shared rate-limit counters.
# Without it the app runs browser-only and hides login.
# MONGODB_URI=
# MONGODB_DB=financial-literacy

# Signs session cookies and keys the hashes that rate-limit counters use instead of emails and IP
# addresses; needed when MONGODB_URI is set. Generate with: openssl rand -base64 32
# AUTH_SECRET=

# Encrypts secrets stored in MongoDB (two-step verification keys). Two-step verification is off
# until it's set. Generate with: openssl rand -base64 32. Never change it without moving the old
# value to DATA_ENCRYPTION_KEY_PREVIOUS, or accounts with two-step verification can't log in.
# DATA_ENCRYPTION_KEY=
# DATA_ENCRYPTION_KEY_PREVIOUS=

# Google sign-in (AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET also work). Redirect URI to register in the
# Google Cloud console: <site URL>/api/auth/callback/google (http://localhost:3000 locally).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Password reset and sign-up confirmation emails (Resend, https://resend.com). Without RESEND_API_KEY,
# "Forgot password?" says reset isn't available (in development links are printed in the terminal instead).
# In production, new accounts must confirm their email only when RESEND_API_KEY and EMAIL_FROM are both set.
# RESEND_API_KEY=
# Sender, on a domain verified in Resend. Unset: Resend's test sender, which only delivers to your own address.
# EMAIL_FROM="Sprout <hello@yourdomain.com>"
# The site's public address, e.g. https://sprout-financial.vercel.app (no path or trailing text).
# Used for links in emails, canonical links, the sitemap and share cards.
# Unset: Vercel's production (or preview) address, or http://localhost:3000 locally.
# SITE_URL=

# Google Search Console's "HTML tag" verification token (only the content="..." value).
# GOOGLE_SITE_VERIFICATION=

# Set to "off" to disable web search and deep research (billed per search).
# WEB_SEARCH=

# Rate limits on the AI endpoints and login. On by default in production, off in development.
# RATE_LIMIT=on
# Most AI calls allowed per day across all visitors. Defaults to 400.
# RATE_LIMIT_DAILY_TOTAL=

# Model that grades replies in `npm run eval`. Defaults to claude-sonnet-5-5.
# EVAL_GRADER_MODEL=
